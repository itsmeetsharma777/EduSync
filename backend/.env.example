# Backend
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/edusync
JWT_SECRET=replace-this-with-a-strong-random-secret-of-at-least-32-characters
NODE_ENV=development

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

RESEND_API_KEY=
EMAIL_FROM=EduSync <noreply@yourdomain.com>

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
