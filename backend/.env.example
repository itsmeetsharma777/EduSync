# Public EduSync AI gateway
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Select exactly one: openai or gemini
AI_PROVIDER=openai

# Never expose this value to the frontend or commit it to Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Only required when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
