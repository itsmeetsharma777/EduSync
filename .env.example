# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/edusync
JWT_SECRET=replace-this-with-a-strong-random-secret-of-at-least-32-characters
NODE_ENV=development

# Required once for the protected administrator account. Replace before deployment.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Google OAuth (optional locally, required to enable the Google sign-in button in deployment)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Email verification (set both to send real verification emails)
RESEND_API_KEY=
EMAIL_FROM=EduSync <noreply@yourdomain.com>

# AI summaries. The transcript is sent only from the authenticated user’s request.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
