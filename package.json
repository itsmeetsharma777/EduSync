{
  "name": "edusync",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run frontend:dev",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:build": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "backend:dev": "tsx watch backend/src/server.ts",
    "backend:build": "tsc -p backend/tsconfig.json",
    "build": "npm run frontend:build && npm run backend:build",
    "lint": "eslint frontend backend --ext .ts,.tsx",
    "format": "prettier --write frontend backend package.json",
    "preview": "vite preview --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@vitejs/plugin-react": "6.0.5",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "framer-motion": "13.0.0",
    "helmet": "8.3.0",
    "jspdf": "4.2.1",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "1.30.0",
    "mongoose": "9.9.1",
    "openai": "7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-toastify": "11.1.0",
    "recharts": "3.10.1",
    "vite": "8.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bcryptjs": "3.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite-plugin-pwa": "1.3.0"
  }
}
